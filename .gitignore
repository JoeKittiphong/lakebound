# Godot 4+ specific ignores
.godot/
/android/

# Generated Android exports and local signing credentials.
/exports/
*.keystore
*.jks
/signing/
/.signing/

# Python tooling caches.
__pycache__/
*.pyc

# Local diagnostics, editor templates, and credentials.
*.log
/export_templates/
/feature_profiles/
/script_templates/
/text_editor_themes/
.env
.env.*
!.env.example
*.dpapi
release-credentials.json

# Packaged builds belong in Releases/artifact storage, not source history.
*.apk
*.aab
*.apks
*.pck
*.dmp

# Local tooling and editor state (keep Godot .import and .uid metadata).
.venv/
venv/
node_modules/
.pytest_cache/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.blend1
*.blend2

# Player progress and private service credentials copied into the project.
/user_data/
angler_profile*.cfg
fish_collection*.cfg
first_catch_tutorial*.cfg
*service-account*.json
*.p12
*.pfx
*.pem
*.key
