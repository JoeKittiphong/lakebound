[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://lab.gd" id="script"]
[node name="WebRTCLab" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("script")
[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24
[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18
[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Lakebound - native WebRTC experiment"
[node name="Description" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "Two actual local peer connections / unordered pose channel / 20 Hz"
[node name="Run" type="Button" parent="Margin/Column"]
layout_mode = 2
text = "Run local peer test"
[node name="Status" type="Label" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
text = "Ready. This is an isolated project; Lakebound matches are unchanged."
autowrap_mode = 2
[connection signal="pressed" from="Margin/Column/Run" to="." method="_run"]
