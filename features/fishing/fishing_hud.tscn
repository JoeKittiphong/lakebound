[node name="Guide" type="Label" parent="SafeArea/EcologyPanel/Content"]
layout_mode = 2
mouse_filter = 2
text = "จอยซ้าย: เดิน • จอยขวา: เล็งแล้วปล่อยเพื่อเหวี่ยง\nเหยื่อปลอม: ขึ้นกระตุก ลงกรอ ซ้ายขวาสะบัด ปล่อยเพื่อหยุด\nสู้ปลา: ประคองเหลือง/แดงเพื่อลดเลือดปลา แดงลดเร็วแต่ยังเสี่ยงสายขาด\nเลือดหมด: หลอดแรงตึงเป็นเหลืองทั้งหมด ลงเพื่อกรอปลาเข้าฝั่ง\nปลากินเบ็ด: ปล่อยจอยแล้วดึงลงเพื่อวัดเบ็ด\nลากพื้นที่ว่างด้านขวา: หมุนกล้อง"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.86, 0.96, 0.92, 1)


