[resource]
script = ExtResource("script")
id = &"rubber_worm"
display_name = "หนอนยาง"
kind = "lure"
equipment_type = "เหยื่อยาง"
shop_icon = ExtResource("icon")
description = "เหยื่อยาง · อุปกรณ์สำหรับทดลอง ค่าสมดุลปรับได้ใน Inspector"
price = 100
bait_type = "lure"
motion = "sink"
lure_pattern = "jerk_fall"
