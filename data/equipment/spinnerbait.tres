[resource]
script = ExtResource("script")
id = &"spinnerbait"
display_name = "สปินเนอร์เบท"
kind = "lure"
equipment_type = "เหยื่อใบหมุน"
shop_icon = ExtResource("icon")
description = "เหยื่อใบหมุน · อุปกรณ์สำหรับทดลอง ค่าสมดุลปรับได้ใน Inspector"
price = 180
bait_type = "lure"
motion = "sink"
lure_pattern = "steady"
lure_visual = "Spinner"
