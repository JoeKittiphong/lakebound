[gd_resource type="Resource" script_class="TackleItem" format=3]
[ext_resource type="Script" path="res://data/equipment/tackle_item.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/ui/shop/equipment_atlas/corn.tres" id="icon"]

[ext_resource type="Resource" path="res://data/equipment/rigs/float.tres" id="rig_float"]
[ext_resource type="Resource" path="res://data/equipment/rigs/pole.tres" id="rig_pole"]
[ext_resource type="Resource" path="res://data/equipment/rigs/bottom.tres" id="rig_bottom"]
[ext_resource type="Resource" path="res://data/equipment/rigs/boat.tres" id="rig_boat"]

[ext_resource type="Script" path="res://data/equipment/terminal_rig_spec.gd" id="rig_spec_type"]

[ext_resource type="PackedScene" path="res://features/equipment/baits/corn.tscn" id="bait_model"]

[ext_resource type="Resource" path="res://data/equipment/attraction/corn.tres" id="attraction"]

[resource]
script = ExtResource("script")
id = &"corn"
display_name = "ข้าวโพด"
kind = "bait"
equipment_type = "เหยื่อผสม · ธัญพืช"
shop_icon = ExtResource("icon")
description = "เหยื่อผสม · ธัญพืช · อุปกรณ์สำหรับทดลอง ค่าสมดุลปรับได้ใน Inspector"
price = 40
quantity = 20
bait_type = "dough"


payload_g = 0.6
terminal_rigs = Array[ExtResource("rig_spec_type")]([ExtResource("rig_float"), ExtResource("rig_pole"), ExtResource("rig_bottom"), ExtResource("rig_boat")])

model_scene = ExtResource("bait_model")

attraction = ExtResource("attraction")
