[gd_resource type="Resource" script_class="TackleItem" format=3]
[ext_resource type="Script" path="res://data/equipment/tackle_item.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/ui/shop/equipment_atlas/crankbait.tres" id="icon"]

[ext_resource type="Resource" path="res://data/equipment/rigs/plug.tres" id="rig_plug"]

