[resource]
script = ExtResource("script")
id = &"crankbait"
display_name = "แครงก์ดำลึก"
kind = "lure"
equipment_type = "ปลั๊กใต้น้ำ"
shop_icon = ExtResource("icon")
description = "ปลั๊กใต้น้ำ · อุปกรณ์สำหรับทดลอง ค่าสมดุลปรับได้ใน Inspector"
price = 170
bait_type = "lure"
motion = "swim"
lure_pattern = "stop_and_go"
lure_visual = "Crank"
sink_speed = 0
swim_depth = 3.5


payload_g = 12
terminal_rigs = Array[ExtResource("rig_spec_type")]([ExtResource("rig_plug")])

model_scene = ExtResource("bait_model")

attraction = ExtResource("attraction")
