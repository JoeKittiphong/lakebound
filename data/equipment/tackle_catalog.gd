# IDs are stable authored catalog keys; retain the original Resource instances.
static var _by_id: Dictionary = {}

static func item(id: String) -> Resource:
 if _by_id.is_empty():
  for entry in ITEMS:
   _by_id[String(entry.id)] = entry
 return _by_id.get(id)
