extends "res://tests/competition_test.gd"
func run() -> void:
 var service: Node=root.get_node("Competition")
 service.enabled=false;service.edge.connected=true;service.room={}
 var notice=service.get_node("InviteNotice")
 root.content_scale_size=Vector2i(1280,720);root.size=Vector2i(1280,720)
 service.edge.social={"invites":[{"id":"invite-test","name":"เพื่อนตกปลา","code":"01234","expires_at":Time.get_unix_time_from_system()+60}]}
 service.get_node("Friends").changed.emit()
 expect(notice.get_node("%Alert").visible,"incoming invitation opens a modal alert without navigating to friends")
 expect(paused,"modal alert pauses underlying input and gameplay")
 expect(not notice.get_node("%Accept").disabled,"idle recipient can accept invitation")
 expect("01234" in notice.get_node("%Message").text,"invitation identifies destination room")
 await process_frame;await RenderingServer.frame_post_draw
 root.get_texture().get_image().save_png("res://exports/qa-two-player/invite-notice.png")
 service.room=fixture();notice.refresh()
 expect(notice.get_node("%Accept").disabled,"cannot silently replace an active room")
 service.room={};service.edge.social.invites[0].expires_at=0;notice.refresh()
 expect(not notice.get_node("%Alert").visible,"expired invitation disappears")
 expect(not paused,"closing alert restores previous pause state")
 service.edge.social={};notice.refresh()
 expect(not notice.get_node("%Alert").visible,"logout or empty invitations clears notification")
 var client_now:=Time.get_unix_time_from_system()
 service.edge.receive_social({"server_time":client_now-120,"invites":[{"id":"clock-skew","name":"เพื่อนเวลาเซิร์ฟเวอร์","code":"54321","expires_at":client_now-60}]})
 expect(notice.get_node("%Alert").visible,"valid invitation opens even when device clock is two minutes ahead")
 expect(not notice.get_node("%Accept").disabled,"clock skew does not block accepting a valid invitation")
 expect("60" in notice.get_node("%Remaining").text,"countdown uses server expiry rather than device wall clock")
 var list=load("res://features/competition/friends_panel.tscn").instantiate();root.add_child(list);list.render()
 expect(list.get_node("%Invites").get_child_count()==1,"friends list also retains invitation despite device clock skew")
 service.edge.receive_social({"server_time":client_now-59,"invites":[{"id":"clock-skew","name":"เพื่อน","code":"54321","expires_at":client_now-60}]})
 expect(not notice.get_node("%Alert").visible,"server-expired invitation closes alert and restores gameplay")
 service.edge.receive_social({"server_time":client_now+120,"invites":[{"id":"behind","name":"เพื่อน","code":"12345","expires_at":client_now+180}]})
 expect(notice.get_node("%Alert").visible,"device clock behind server also shows valid invitation")
 service.edge.close()
 expect(not paused,"disconnect clears modal and restores input")
 print("INVITE NOTICE RESULT: ",checks," checks, ",failures," failures");quit(1 if failures else 0)
