extends SceneTree
var checks := 0
var failures := 0
var out: String
func _initialize() -> void: call_deferred("run")
func expect(ok: bool, label: String) -> void:
 checks += 1
 if not ok:
  failures += 1
  push_error("FAIL: " + label)
 else: print("PASS: ", label)
func settle() -> void:
 for i in 4: await process_frame
func run() -> void:
 out = OS.get_environment("LAKEBOUND_QA_DIR")
 var profile: AnglerProfile = root.get_node("AnglerSave")
 root.get_node("FishCollection").recording_enabled = false
 profile.data = profile.defaults()
 profile.save_path = out.path_join("equipment-removal.cfg")
 profile.data.stock.casting_rod = 1
 expect(profile.equip("casting_rod"), "owned rod selectable without owning any matching reel yet")
 profile.data = profile.defaults()
 expect(profile.grant_trial_equipment(), "owned test equipment available")
 profile.data.line_remaining = 23.5
 var stock: Dictionary = profile.data.stock.duplicate(true)
 expect(profile.equip("casting_rod"), "new rod accepted with old incompatible tackle mounted")
 for slot in ["reel", "line", "bait"]:
  expect(profile.equipped(slot) == null, "new rod clears " + slot)
 expect(profile.data.stock == stock, "removing attached gear never consumes inventory")
 expect(profile.data.stored_lines.nylon == [23.5], "partial spool returned at exact remaining length")
 expect(profile.data.line_remaining == 0 and profile.current_rig() == null, "detached line and terminal rig are inactive")
 expect(not profile.prepare_cast(), "incomplete set cannot cast")
 expect(profile.equip("baitcasting_reel"), "new rod can select its matching reel")
 expect(profile.equip("nylon") and profile.data.line_remaining == 23.5, "partial spool can be re-equipped without refill")
 expect(profile.equip("worm"), "compatible bait completes replacement set")
 expect(profile.current_fit_error().is_empty(), "replacement tackle becomes usable")
 var spares: Dictionary = profile.data.spares.duplicate(true)
 expect(profile.unequip("line"), "individual line detaches")
 expect(profile.equip("nylon") and profile.data.line_remaining == 23.5, "detach and reattach preserves length again")
 expect(profile.data.spares == spares, "reattach consumes no new spare spool")
 expect(profile.equip("casting_rod") and profile.equipped("reel") != null, "selecting same rod preserves assembled tackle")
 expect(profile.equip("pole_rod"), "switch to fixed-line rod")
 expect(profile.equipped("reel") == null and profile.equipped("bait") == null, "fixed-line rod also starts with empty attachments")
 expect(profile.equip("nylon") and profile.equip("worm"), "fixed-line rod assembles without a reel")
 expect(profile.current_fit_error().is_empty(), "complete fixed-line rig is usable")
 expect(profile.unequip("rod"), "rod can be removed completely")
 expect(profile.equipped("rod") == null and profile.equipped("line") == null, "removing rod detaches dependent components")
 expect(profile.unequip("box"), "empty fish box can be removed")
 expect(ProfileStore.valid(profile.data), "intentional empty slots are valid saved state")
 var persisted := profile.data.duplicate(true)
 profile.load_profile()
 expect(not profile.incompatible and profile.data.equipped == persisted.equipped and profile.data.stored_lines == persisted.stored_lines and profile.data.line_remaining == persisted.line_remaining and profile.data.stock == persisted.stock and profile.data.spares == persisted.spares and profile.data.coins == persisted.coins, "empty slots and partial spools survive reload without auto-filling")
 expect(profile.line_capacity() == 0 and not profile.current_fit_error().is_empty(), "empty saved loadout reports missing gear")
 var legacy := profile.defaults()
 legacy.erase("stored_lines")
 var cfg := ConfigFile.new()
 cfg.set_value("meta", "version", 1)
 cfg.set_value("profile", "data", legacy)
 var legacy_path := out.path_join("legacy-equipment.cfg")
 cfg.save(legacy_path)
 var migrated := ProfileStore.load_profile(legacy_path)
 expect(not migrated.incompatible and migrated.data.equipped.rod == "light_rod", "old complete profile migrates without gear changes")
 var invalid := persisted.duplicate(true)
 invalid.equipped.rod = "not-a-rod"
 expect(not ProfileStore.valid(invalid), "unknown equipment still rejected")
 invalid = persisted.duplicate(true)
 invalid.stored_lines.nylon = [99999.0]
 expect(not ProfileStore.valid(invalid), "invalid stored spool length still rejected")
 profile.data.pending = {"id":"pending"}
 var pending_before := profile.data.duplicate(true)
 expect(not profile.equip("light_rod") and profile.data == pending_before, "pending recovery prevents equipment mutation")
 profile.data.pending = {}
 profile.data = profile.defaults()
 profile.data.catches = [{"weight":1.0}]
 expect(not profile.unequip("box") and profile.equipped("box") != null, "box containing fish cannot be detached")
 profile.data = persisted.duplicate(true)
 var pond := PondEcosystem.new()
 var fishing := FishingController.new()
 fishing.profile = profile
 fishing.ecosystem = pond
 var gateway := CommerceGateway.new()
 var panel: Control = load("res://features/economy/tackle_panel.tscn").instantiate()
 root.add_child(panel)
 panel.bind(profile, fishing, pond, gateway)
 panel.open()
 var shop: Control = panel.get_node("Shop")
 shop.get_node("%Gear").pressed.emit()
 await settle()
 expect(shop.get_node("%LoadoutHint").text.contains("ยังไม่ได้ใส่"), "overview explains empty slots")
 expect(shop.get_node("%SelectRod").text.contains("ว่าง"), "empty rod slot stays selectable")
 shop.set_category(2)
 shop.browser.item_pressed.emit(TackleCatalog.item("light_rod"))
 shop.inspector.get_node("%Equip").pressed.emit()
 await settle()
 expect(profile.equipped("rod").id == &"light_rod" and shop.category == 3, "rod selection advances to reel with attachments empty")
 shop.get_node("%Gear").pressed.emit()
 await settle()
 expect(shop.inspector.get_node("%Unequip").visible, "overview exposes authored remove button")
 shop.inspector.get_node("%Unequip").pressed.emit()
 await settle()
 expect(profile.equipped("rod") == null and shop.get_node("%Loadout").visible, "remove button keeps overview open and clears rod")
 expect(shop.get_node("%LoadoutView").assembled_rod() == null, "3D overview removes actual rod model")
 for slot in ["reel", "line", "bait", "box"]:
  profile.data = profile.defaults()
  shop.refresh()
  shop._inspect_item(profile.equipped(slot))
  await settle()
  expect(shop.inspector.get_node("%Unequip").visible, "remove control shown for " + slot)
  expect(not shop.get_node("%Remove"+slot.capitalize()).disabled, "overview slot remove enabled for " + slot)
  shop.get_node("%Remove"+slot.capitalize()).pressed.emit()
  await settle()
  expect(profile.equipped(slot) == null, "overview removes selected " + slot)
 profile.data = persisted.duplicate(true)
 panel.close()
 panel.queue_free()
 fishing.free()
 pond.free()
 gateway.free()
 await settle()
 var game: Node3D = load("res://features/regions/grand_river.tscn").instantiate()
 root.add_child(game)
 current_scene = game
 await settle()
 var controller: FishingController = game.get_node("FishingController")
 expect(not controller.cast_block_reason().is_empty(), "real gameplay blocks empty loadout safely")
 expect(game.player.character_model.rod_mesh == null, "world character has no phantom rod")
 expect(profile.equip("light_rod"), "empty gameplay loadout can select a new rod")
 controller.refresh_equipment()
 await settle()
 expect(game.player.character_model.rod_mesh.held_reel == null, "new gameplay rod has no phantom reel")
 expect(not game.player.character_model.rod_mesh.line_attached, "new gameplay rod has no phantom line")
 expect(profile.unequip("rod"), "world rod can be detached again")
 controller.refresh_equipment()
 await settle()
 var old_path := profile.save_path
 var snapshot := profile.data.duplicate(true)
 profile.save_path = out.path_join("missing-directory/cannot-save.cfg")
 expect(not profile.equip("light_rod") and profile.data == snapshot, "failed save rolls back whole equipment transaction")
 profile.save_path = old_path
 game.queue_free()
 await settle()
 print("EQUIPMENT REMOVAL RESULT: ", checks, " checks, ", failures, " failures")
 quit(0 if failures == 0 else 1)
